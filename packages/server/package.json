{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && echo '{\"type\":\"commonjs\"}' > dist/package.json",
    "start:node": "node dist/server.js",
    "test": "node --import tsx --test test/*/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*/*.test.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.13"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@eventhub/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.2",
    "socket.io": "^4.8.3"
  }
}